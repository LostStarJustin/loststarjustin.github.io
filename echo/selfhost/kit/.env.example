# Echo 自托管服务器环境变量。复制为同目录 .env 并填入真实值。
# Echo self-hosted server settings. Copy to .env in the same directory and fill in real values.
# 生成强随机值 / generate a strong random value:  openssl rand -hex 24

# Postgres 密码（仅 compose 内网使用）/ Postgres password (compose-internal only)
POSTGRES_PASSWORD=__GENERATE__

# LiveKit API key / secret（≥32 字符；必须与 livekit.yaml 里替换的值一致）
# LiveKit API key / secret (>=32 chars; must match the values you put into livekit.yaml)
LIVEKIT_API_KEY=__GENERATE__
LIVEKIT_API_SECRET=__GENERATE__

# 后端镜像版本 = Echo 应用版本号，与客户端版本保持一致（必填，无默认）
# Backend image tag = Echo app version; keep it equal to the client version (required, no default)
IMAGE_TAG=0.29.6

# 本机公网 IP。客户端登录页填 http://<此 IP>:8080
# Public IP of this machine. Clients log in with http://<this IP>:8080
SERVER_PUBLIC_IP=__FILL_PUBLIC_IP__

# 可选：以后加 TLS 时打开 / optional, enable when you put TLS in front
# BACKEND_SCHEME=https
# LK_SCHEME=wss
